# Public site URL (SEO, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=https://gobiba.pl

# Resend — https://resend.com/docs/send-with-nextjs
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=gobiba Rezerwacje <rezerwacje@gobiba.pl>

# Inbox for booking notifications (defaults to kontakt@gobiba.pl)
BOOKING_TO_EMAIL=kontakt@gobiba.pl

# Reply-to for customer confirmation emails (defaults to kontakt@gobiba.pl)
BOOKING_REPLY_TO=kontakt@gobiba.pl

# Admin panel — Ctrl+Shift+E on the site
ADMIN_PASSWORD=your-secure-password-here
# Optional: separate secret for session tokens (defaults to ADMIN_PASSWORD)
# ADMIN_SECRET=

# Upstash Redis (Vercel Marketplace) — persists calendar + prices in production
# Without these, dev saves to .data/site-config.json locally
KV_REST_API_URL=
KV_REST_API_TOKEN=

